{
  "name": "buddy-hq",
  "productName": "Buddy HQ",
  "version": "0.1.0",
  "private": true,
  "description": "Privates Betriebs-Dashboard für Buddy Island",
  "author": "Wolf Widmer",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "secret-scan": "node scripts/secret-scan.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.6"
  },
  "build": {
    "appId": "top.buddy-island.hq",
    "productName": "Buddy HQ",
    "artifactName": "Buddy-HQ-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
